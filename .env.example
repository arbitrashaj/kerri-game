# Node 24.15+. Copy values to your shell or hosting environment.
PORT=3000
KERRI_DB=./data/kerri.sqlite
ANALYTICS_ENABLED=false
# Comma-separated exact origins: production web origin and native app origins.
ALLOWED_ORIGINS=https://your-game.onrender.com,https://localhost,capacitor://localhost
# Public build configuration. Leave empty for a same-origin web build.
SERVER_URL=
# Development only: permits HTTP localhost in native build.
ALLOW_INSECURE_LOCALHOST=false
